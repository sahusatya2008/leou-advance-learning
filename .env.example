# Copy to .env and fill in. Never commit the real .env.

# Managed Postgres (Neon/Supabase/RDS all work). Use the pooled URL in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Signs session + prelogin cookies. Generate with: openssl rand -hex 32
JWT_SECRET=""

# Where the Next app reaches the Python face service.
# Local: http://127.0.0.1:8000   Container/VM: http://127.0.0.1:8000
FACE_SVC_URL="http://127.0.0.1:8000"

# Code runner service (if used)
RUNNER_URL=""

# Where uploaded files land
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# Payments (LeouPay - manual UPI verification)
# REQUIRED: without PAYMENT_UPI_ID students cannot pay. Every other value has a
# working default, but the UPI id has no sensible default.
# ---------------------------------------------------------------------------
# The UPI id students send money to, e.g. "leou@okaxis".
PAYMENT_UPI_ID="your-upi-id@okaxis"
# Name shown beside the amount in the student's UPI app.
PAYMENT_PAYEE_NAME="LEOU"
# Optional: your own PhonePe QR image, placed in /public (e.g. "/payment-qr.png").
# Leave empty to have a QR generated from PAYMENT_UPI_ID so the two can never
# disagree. If set to a path that does not exist, a generated QR is used instead.
PAYMENT_QR_IMAGE=""
# Number a student can call if UPI fails. Defaults to SERVICE_CONTACT.
PAYMENT_HELPLINE=""
# Text shown next to the QR so a student can confirm who they paid.
PAYMENT_BANK_NOTE="LEOU tuition fees"
